<Window x:Class="PinCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PinCreator.Models"
        Title="Pin Creator Batch Studio" Width="1520" Height="930" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Ink}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:LayoutDefinition}">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{Binding Accent}" CornerRadius="3"/>
                <StackPanel Grid.Column="1" Margin="10,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>

        <Border Background="#141F27" BorderBrush="#2B3943" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PIN CREATOR" FontFamily="Georgia" FontWeight="Bold" FontSize="22" Foreground="{StaticResource Paper}"/>
                        <Border Background="#293842" CornerRadius="12" Padding="9,3" Margin="12,1,0,0"><TextBlock Text="BATCH STUDIO" Foreground="{StaticResource Gold}" FontSize="9" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <TextBlock x:Name="QueueCountText" Text="Build a queue to begin" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="RefreshApp_Click"/>
                    <Button Content="Add folder" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="AddFolder_Click"/>
                    <Button x:Name="BatchExportButton" Content="Run batch" Style="{StaticResource PrimaryButton}" Padding="26,12" Click="ExportBatch_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Queue -->
            <Border Grid.Column="0" Background="#131E26" BorderBrush="#2B3943" BorderThickness="0,0,1,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="1  SOURCE QUEUE" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Images and their individual copy" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,-6,0,14"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                        <Button Content="Images" Style="{StaticResource QuietButton}" Margin="0,0,7,7" Click="AddBatchImages_Click"/>
                        <Button Content="Folder" Style="{StaticResource QuietButton}" Margin="0,0,7,7" Click="AddFolder_Click"/>
                        <Button Content="CSV" Style="{StaticResource QuietButton}" Margin="0,0,7,7" Click="ImportCsv_Click"/>
                        <Button Content="Title|code" Style="{StaticResource QuietButton}" Margin="0,0,0,7" Click="ImportTitles_Click"/>
                    </WrapPanel>
                    <ListBox Grid.Row="2" x:Name="BatchList" Background="#0E171D" BorderBrush="#34434E" BorderThickness="1"
                             Foreground="#F6F0E8" SelectionChanged="BatchList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,3"/><Setter Property="Background" Value="#17242C"/>
                                <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2B3A44"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="11,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding Code}" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock Text="  " FontSize="10"/><TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#24343E" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Gold}" FontSize="9"/></Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Remove selected" Style="{StaticResource QuietButton}" Click="RemoveSelected_Click"/>
                        <Button Grid.Column="2" Content="Clear queue" Style="{StaticResource QuietButton}" Click="ClearBatch_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Batch input and output -->
            <Border Grid.Column="1" Background="#162129" BorderBrush="#2B3943" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,20,22,28">
                        <TextBlock Text="2  INPUT FILE" Style="{StaticResource SectionTitle}"/>
                        <Border Background="#101A21" BorderBrush="#34434E" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="TITLE BANK" Style="{StaticResource Label}"/>
                                <TextBlock Text="Select an input.txt containing one title|code pair per line." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Content="Select input.txt" Style="{StaticResource PrimaryButton}" Click="ImportTitles_Click"/>
                                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource QuietButton}" Margin="10,0,0,0" Click="RefreshApp_Click"/>
                                </Grid>
                                <TextBox x:Name="InputFileBox" Text="No input file selected" IsReadOnly="True" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InputSummaryText" Text="Waiting for a title bank" Foreground="{StaticResource Gold}" FontSize="10" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#101A21" BorderBrush="#34434E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="AUTOMATIC PRODUCTION" Style="{StaticResource Label}"/>
                                <TextBlock Text="Images pair with input lines in order. Layouts rotate automatically to keep the batch varied." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#30404B" Margin="0,22"/>
                        <TextBlock Text="OUTPUT SETTINGS" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="CANVAS" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="SizeBox" SelectionChanged="Input_Changed"/>
                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="FORMAT" Style="{StaticResource Label}"/><ComboBox x:Name="FormatBox" SelectedIndex="1"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/></ComboBox></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="JPG QUALITY" Style="{StaticResource Label}"/><TextBox x:Name="QualityBox" Text="85"/></StackPanel>
                        </Grid>
                        <TextBlock Text="THREADS" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                        <ComboBox x:Name="ThreadBox" SelectionChanged="Input_Changed"/>
                        <TextBlock Text="DESTINATION" Style="{StaticResource Label}" Margin="0,12,0,6"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="ChooseOutput_Click"/><TextBox x:Name="OutputBox" IsReadOnly="True"/></DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview -->
            <Grid Grid.Column="2" Background="#0C1419">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                <Grid Margin="26,20,26,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="3  PREVIEW" Style="{StaticResource SectionTitle}"/><TextBlock Text="Selected queue item with its automatic layout" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,-6,0,0"/></StackPanel>
                    <Border Grid.Column="1" Background="#19252D" CornerRadius="14" Padding="11,5" VerticalAlignment="Top"><TextBlock x:Name="PreviewMeta" Text="No item selected" Foreground="{StaticResource Muted}" FontSize="10"/></Border>
                </Grid>
                <Grid Grid.Row="1" Margin="26,10,26,24">
                    <Border Background="#05090C" CornerRadius="10" Padding="18">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                <Border Width="72" Height="72" CornerRadius="36" Background="#1C2932" Margin="0,0,0,18"><TextBlock Text="+" FontSize="34" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="Drop a folder or images here" FontFamily="Georgia" FontSize="24" TextAlignment="Center"/>
                                <TextBlock Text="Titles start from filenames. Import a CSV or text title bank when you need custom copy." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#141F27" BorderBrush="#2B3943" BorderThickness="0,1,0,0">
                    <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Preview only. Every queued item exports at full resolution." Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10"/><Button Grid.Column="1" Content="Run batch" Style="{StaticResource PrimaryButton}" Padding="22,9" VerticalAlignment="Center" Click="ExportBatch_Click"/></Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#091015">
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready for a batch" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="10"/><ProgressBar x:Name="Progress" Grid.Column="1" Height="5" VerticalAlignment="Center" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#25333D"/></Grid>
        </Border>
    </Grid>
</Window>
