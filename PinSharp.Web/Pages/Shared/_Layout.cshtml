<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PinSharp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PinSharp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-shell">
        <div class="topbar">
            <a class="brand" asp-area="" asp-page="/Index">PinSharp</a>
            <span class="brand-tag">ASP.NET Core Batch Studio</span>
        </div>
    </header>
    <div class="page-shell">
        <main role="main" class="page-main">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
